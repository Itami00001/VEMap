# VEMap — required environment variables
# Copy to .env and fill in real values (never commit .env)

# Backend
DATABASE_URL=postgresql://mapmood:mapmood@localhost:5432/mapmood
JWT_SECRET=generate-with-openssl-rand-base64-32
ADMIN_EMAIL=admin@mapmood.local
ADMIN_PASSWORD=changeme
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite

CHAT_ALLOW_CLOUD=true
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=Qwen2.5-1.5B-Instruct
WIKI_TELEGRAM_TOKEN=
WIKI_TELEGRAM_CHAT_ID=0
WIKI_TRUST_PROXY=false
WIKI_PROCESSOR=[]
WIKI_OCR_COMMAND=[]

# Frontend (build-time, baked into dist)
VITE_API_URL=http://localhost:8001
VITE_USE_MOCKS=false
